# Banco de dados Postgres.
# Coolify (Postgres interno): use a "Internal URL" do recurso de banco, algo como:
#   postgres://postgres:SENHA@<uuid-do-banco>:5432/postgres
# Supabase: postgresql://postgres:SENHA@db.<ref>.supabase.co:5432/postgres
# Se usar pooler/pgBouncer (porta 6543), acrescente: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgres://postgres:SENHA@HOST:5432/postgres"

# OBRIGATÓRIO em produção: string aleatória com 32+ caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET="troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres"

# Superadmin criado pelo seed (node prisma/seed.mjs)
SEED_ADMIN_EMAIL="admin@genesisia.com.br"
SEED_ADMIN_PASSWORD=""
# SEED_DEMO=1  # descomente para popular um escritório de exemplo

# Assistente de IA (opcional — sem a chave, o assistente fica desativado)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
