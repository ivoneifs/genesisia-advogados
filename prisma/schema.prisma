generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Escritorio {
  id          String    @id @default(cuid())
  nome        String
  ativo       Boolean   @default(true)
  plano       String    @default("TRIAL") // TRIAL | BASICO | PRO
  status      String    @default("TRIAL") // TRIAL | ATIVO | SUSPENSO
  trialExpira DateTime?
  createdAt   DateTime  @default(now())

  users        User[]
  advogados    Advogado[]
  clientes     Cliente[]
  processos    Processo[]
  prazos       Prazo[]
  tarefas      Tarefa[]
  financeiros  Financeiro[]
  contatos     Contato[]
  publicacoes  Publicacao[]
  documentos   Documento[]
  workflows    Workflow[]
  atendimentos Atendimento[]

  configWhatsapp ConfigWhatsapp?
  alertasEnviados AlertaEnviado[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADVOGADO")
  ativo     Boolean  @default(true)
  whatsapp  String?  // recebe alertas da agenda, prazos e publicações
  createdAt DateTime @default(now())

  escritorioId String?
  escritorio   Escritorio? @relation(fields: [escritorioId], references: [id])

  processos Processo[]
  prazos    Prazo[]
  tarefas   Tarefa[]
}

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  tipo        String   @default("PF")
  documento   String?
  email       String?
  telefone    String?
  endereco    String?
  observacoes String?
  receberWhatsapp Boolean @default(true) // avisos de audiências/reuniões
  createdAt   DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  processos    Processo[]
  financeiros  Financeiro[]
  documentos   Documento[]
  atendimentos Atendimento[]
}

model Processo {
  id             String   @id @default(cuid())
  numero         String
  area           String?
  status         String   @default("ATIVO")
  tribunal       String?
  vara           String?
  parteContraria String?
  valorCausa     Float?
  descricao      String?
  advogados      Json?    // [{ nome, oab, uf }] vindos do DJEN
  createdAt      DateTime @default(now())

  escritorioId   String
  escritorio     Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])

  responsavelId  String?
  responsavel    User?    @relation(fields: [responsavelId], references: [id])

  prazos         Prazo[]
  tarefas        Tarefa[]
  financeiros    Financeiro[]
  documentos     Documento[]
  publicacoes    Publicacao[]
  atendimentos   Atendimento[]
}

model Prazo {
  id             String   @id @default(cuid())
  titulo         String
  descricao      String?
  dataVencimento DateTime
  status         String   @default("PENDENTE")
  prioridade     String   @default("NORMAL")
  createdAt      DateTime @default(now())

  escritorioId   String
  escritorio     Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  processoId     String
  processo       Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)

  responsavelId  String?
  responsavel    User?    @relation(fields: [responsavelId], references: [id])
}

model Tarefa {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  data          DateTime
  tipo          String   @default("TAREFA")
  concluida     Boolean  @default(false)
  createdAt     DateTime @default(now())

  escritorioId  String
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  processoId    String?
  processo      Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)

  responsavelId String?
  responsavel   User?    @relation(fields: [responsavelId], references: [id])
}

model Financeiro {
  id          String   @id @default(cuid())
  tipo        String
  descricao   String
  valor       Float
  vencimento  DateTime
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
}

model Contato {
  id          String   @id @default(cuid())
  nome        String
  tipo        String   @default("OUTRO")
  email       String?
  telefone    String?
  empresa     String?
  observacoes String?
  createdAt   DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
}

model Publicacao {
  id             String    @id @default(cuid())
  conteudo       String
  diario         String?
  dataPublicacao DateTime?
  status         String    @default("NAO_TRATADA")
  alertaEnviado  Boolean   @default(false) // já avisada no WhatsApp
  createdAt      DateTime  @default(now())

  escritorioId   String
  escritorio     Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  processoId     String?
  processo       Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
}

model Documento {
  id          String   @id @default(cuid())
  titulo      String
  tipo        String   @default("OUTRO")
  observacoes String?
  arquivoNome String?
  arquivoTipo String?
  arquivoTam  Int?
  createdAt   DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  processoId  String?
  processo    Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)

  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
}

model Workflow {
  id         String   @id @default(cuid())
  nome       String
  gatilho    String
  diasAntes  Int      @default(0)
  ativo      Boolean  @default(true)
  execucoes  Int      @default(0)
  createdAt  DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
}

model Atendimento {
  id         String   @id @default(cuid())
  titulo     String
  descricao  String?
  tipo       String   @default("PRESENCIAL") // PRESENCIAL | TELEFONE | WHATSAPP | EMAIL | VIDEO
  status     String   @default("CONCLUIDO") // ABERTO | CONCLUIDO
  data       DateTime @default(now())
  createdAt  DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  processoId String?
  processo   Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
}

model Advogado {
  id          String   @id @default(cuid())
  nome        String
  oab         String // só dígitos
  uf          String
  cpf         String?
  email       String?
  telefone    String?
  endereco    String? // endereço profissional
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, oab, uf])
}

// Alertas por WhatsApp (Evolution API). Uma configuração por escritório.
model ConfigWhatsapp {
  id            String   @id @default(cuid())
  ativo         Boolean  @default(false)
  instancia     String?  // instância própria na Evolution; vazia = número central
  agenda        Boolean  @default(true)
  prazos        Boolean  @default(true)
  publicacoes   Boolean  @default(true)
  resumoDiario  Boolean  @default(true)
  clientes      Boolean  @default(false) // avisar clientes de audiências/reuniões
  horaResumo    Int      @default(7)     // hora de Brasília
  updatedAt     DateTime @updatedAt

  escritorioId  String   @unique
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
}

// Registro de cada envio. A chave única impede mandar o mesmo alerta duas vezes.
model AlertaEnviado {
  id           String   @id @default(cuid())
  chave        String   @unique
  tipo         String   // AGENDA | PRAZO | PUBLICACOES | RESUMO | TESTE
  destino      String   // número em E.164 sem "+"
  nome         String?
  ok           Boolean  @default(true)
  erro         String?
  createdAt    DateTime @default(now())

  escritorioId String
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([escritorioId, createdAt])
}
